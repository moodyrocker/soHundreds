{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true
  },
  "include": ["src/**/*"],
  // Tests sit beside the code but must not reach the build output, or
  // dist/ would carry them into the container image.
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "vitest.config.ts"]
}
