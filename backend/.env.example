PORT=3001

# Supabase → Project Settings → Database → Connection string (URI, pooler :6543)
DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_SSL=true

ANTHROPIC_API_KEY=
ENCRYPTION_KEY=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/integrations/callback

# Frontend origin for CORS (optional in local dev)
WEB_ORIGIN=http://localhost:5000

# Supabase Auth (Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
