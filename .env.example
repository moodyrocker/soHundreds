# Copy to .env and fill in values from Supabase Dashboard → Project Settings → Database

PORT=3001
WEB_PORT=5000

# Supabase: use "Connection string" → URI (Transaction pooler, port 6543, recommended for API)
# Example: postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Set true if not using supabase.co in the URL (Docker sets this automatically)
DATABASE_SSL=true

ANTHROPIC_API_KEY=
ENCRYPTION_KEY=

# Setup guide for all integrations: INTEGRATIONS_SETUP.md

# Google Cloud → APIs & Services → Credentials → OAuth client (Web)
# Authorized redirect URI must match GOOGLE_OAUTH_REDIRECT_URI exactly
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/integrations/callback

WEB_ORIGIN=http://localhost:5000

# Supabase Auth (required for user login / multi-tenant)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# NOTE: SUPABASE_SERVICE_ROLE_KEY was removed — nothing in the codebase read it.
# The service-role key bypasses RLS entirely, so holding one that no code needs is
# pure downside risk. The backend already connects as the database owner over
# DATABASE_URL for privileged work. If you ever genuinely need it, add it back
# scoped to the single script that requires it, never to the shared .env.

# Frontend (web/) — same Supabase URL + anon key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:3001

# Google Ads API (disabled by default — set GOOGLE_ADS_ENABLED=true when ready)
# https://ads.google.com/aw/apicenter — apply for developer token
GOOGLE_ADS_ENABLED=false
GOOGLE_ADS_DEVELOPER_TOKEN=
# Use v20+ (v18 returns 404 — sunset Aug 2025)
GOOGLE_ADS_API_VERSION=v20

# Meta Marketing API (Phase 1C)
# developers.facebook.com → Facebook Login → Settings → Valid OAuth Redirect URIs
# Meta often requires https — for local dev use an ngrok URL (see README “Meta OAuth and HTTPS”)
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:5000/integrations/callback
# Example with ngrok: META_OAUTH_REDIRECT_URI=https://YOUR-SUBDOMAIN.ngrok-free.app/integrations/callback
# Instagram Business Login — separate from Meta Ads (Facebook App ID at top of dashboard).
# Meta Developer → Your app → Instagram → API setup with Instagram login → Business login settings
# Copy the Instagram App ID and Instagram App Secret shown there (NOT META_APP_ID).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Same redirect URI must be listed in Instagram Business login settings:
# INSTAGRAM_OAUTH_REDIRECT_URI=https://YOUR-SUBDOMAIN.ngrok-free.app/integrations/callback
# META_GRAPH_API_VERSION=v21.0
# Optional: only if Meta Developer asks for webhook callback + verify token (not required for OAuth login)
# META_WEBHOOK_VERIFY_TOKEN=choose-any-secret-string
# Webhook URL in Meta: https://YOUR-SUBDOMAIN.ngrok-free.app/api/meta/webhook

# Shopify Partner app (Phase 1D — read-only)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_OAUTH_REDIRECT_URI=http://localhost:5000/integrations/callback
# Read-only until Shopify app review approves write scopes (default):
SHOPIFY_SCOPES=read_orders,read_products,read_content
# Full autopilot (pages + product SEO writes) after approval:
# SHOPIFY_SCOPES=read_orders,read_products,read_content,write_content,write_products
# MCP bridge public URLs (https — same host as WEB_ORIGIN / ngrok)
# ANALYTICS_MCP_PUBLIC_URL=https://YOUR-HOST/mcp/analytics
# GOOGLE_ADS_MCP_PUBLIC_URL=https://YOUR-HOST/mcp/google-ads
# META_ADS_MCP_PUBLIC_URL=https://YOUR-HOST/mcp/meta-ads
# SHOPIFY_MCP_PUBLIC_URL=https://YOUR-HOST/mcp/shopify
# UNSPLASH_MCP_PUBLIC_URL=https://YOUR-HOST/mcp/unsplash
# CANVA_MCP_PUBLIC_URL=https://YOUR-HOST/mcp/canva
# RUNWAY_MCP_PUBLIC_URL=https://YOUR-HOST/mcp/runway
# INSTAGRAM_MCP_PUBLIC_URL=https://YOUR-HOST/mcp/instagram
# MAILCHIMP_MCP_PUBLIC_URL=https://YOUR-HOST/mcp/mailchimp
# MCP_BRIDGE_SECRET=   # optional; defaults to ENCRYPTION_KEY
# Unsplash stock photos (workspace-level — no OAuth)
# UNSPLASH_ACCESS_KEY=   # https://unsplash.com/developers
# Canva Connect — design create/export for Instagram workflow (per-workspace OAuth)
# Create integration at https://www.canva.dev/ → Credentials + redirect URI
# CANVA_CLIENT_ID=
# CANVA_CLIENT_SECRET=
# CANVA_OAUTH_REDIRECT_URI=http://localhost:5000/integrations/callback
# Runway Developer API — AI video for Instagram Reels (workspace-level API key)
# Get a key at https://dev.runwayml.com/ — API credits are separate from app.runwayml.com
# RUNWAY_API_KEY=
# RUNWAY_API_VERSION=2024-11-06
# Mailchimp — per-workspace API key (paste in Integrations UI; no global key required)
# Key format includes datacenter: xxxxx-us21 — Account → Extras → API keys
# MAILCHIMP_MCP_PUBLIC_URL is optional when API shares WEB_ORIGIN
# Instagram assist: propose on-brand image + caption preview (no auto-publish). Default off.
# INSTAGRAM_IMAGE_PREVIEW=false
# Autonomous publishing (sequential autopilot — no human gate except paid ads)
# INSTAGRAM_AUTO_PUBLISH=true
# SHOPIFY_AUTO_PUBLISH_LIVE=true
# ── Autopilot cycle worker ───────────────────────────────────────────────────
# The agent loop runs in its own container (the `worker` service in
# docker-compose.yml), NOT in the API. Work is claimed atomically in Postgres
# with FOR UPDATE SKIP LOCKED, so multiple worker replicas are safe — but raise
# AUTOPILOT_CYCLE_CONCURRENCY before adding replicas.
#
# Per-org Autopilot pace in Settings (normal/high/intense) sets due cadence.
# AUTOPILOT_CYCLE_HOURS=1
# How often the worker wakes to look for due strategies (minutes)
# AUTOPILOT_CYCLE_TICK_MINUTES=5
# Strategies claimed per tick, and how many are processed at once.
# AUTOPILOT_CYCLE_BATCH_SIZE=10
# AUTOPILOT_CYCLE_CONCURRENCY=3
# A claim held longer than this is treated as orphaned by a dead worker and
# reclaimed. Must exceed the longest realistic cycle (Runway video ~15m).
# AUTOPILOT_CLAIM_STALE_MINUTES=30
#
# Runs the loop inside the API process instead. ONLY for a single-process local
# run with no worker container — never set true on a scaled API, or several
# replicas will drive the agent at once.
# AUTOPILOT_CYCLE_WORKER=false
# Optional: use Google's hosted analytics MCP URL instead of Hundres bridge
# ANALYTICS_MCP_OFFICIAL_URL=https://analytics-mcp.googleapis.com/mcp/v1

# Learning layer — minimum actions before patterns inject into plans; decay window (days)
# LEARNING_MIN_SAMPLE_SIZE=3
# LEARNING_DECAY_DAYS=90
# LEARNING_TOP_PATTERNS=5
