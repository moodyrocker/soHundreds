# Copy to .env and fill in values from Supabase Dashboard → Project Settings → Database

PORT=3001
WEB_PORT=5000

# Supabase: use "Connection string" → URI (Transaction pooler, port 6543, recommended for API)
# Example: postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Set true if not using supabase.co in the URL (Docker sets this automatically)
DATABASE_SSL=true

ANTHROPIC_API_KEY=
ENCRYPTION_KEY=

# Setup guide for all integrations: INTEGRATIONS_SETUP.md

# Google Cloud → APIs & Services → Credentials → OAuth client (Web)
# Authorized redirect URI must match GOOGLE_OAUTH_REDIRECT_URI exactly
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/integrations/callback

WEB_ORIGIN=http://localhost:5000

# Supabase Auth (required for user login / multi-tenant)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# Admin API access (optional — for server-side admin tasks)
SUPABASE_SERVICE_ROLE_KEY=

# Frontend (web/) — same Supabase URL + anon key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:3001

# Google Ads API (Phase 1B — required for Ads integration)
# https://ads.google.com/aw/apicenter — apply for developer token
GOOGLE_ADS_DEVELOPER_TOKEN=
# Use v20+ (v18 returns 404 — sunset Aug 2025)
GOOGLE_ADS_API_VERSION=v20

# Meta Marketing API (Phase 1C)
# developers.facebook.com → Facebook Login → Settings → Valid OAuth Redirect URIs
# Meta often requires https — for local dev use an ngrok URL (see README “Meta OAuth and HTTPS”)
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:5000/integrations/callback
# Example with ngrok: META_OAUTH_REDIRECT_URI=https://YOUR-SUBDOMAIN.ngrok-free.app/integrations/callback
# Instagram Business Login — separate from Meta Ads (Facebook App ID at top of dashboard).
# Meta Developer → Your app → Instagram → API setup with Instagram login → Business login settings
# Copy the Instagram App ID and Instagram App Secret shown there (NOT META_APP_ID).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Same redirect URI must be listed in Instagram Business login settings:
# INSTAGRAM_OAUTH_REDIRECT_URI=https://YOUR-SUBDOMAIN.ngrok-free.app/integrations/callback
# META_GRAPH_API_VERSION=v21.0
# Optional: only if Meta Developer asks for webhook callback + verify token (not required for OAuth login)
# META_WEBHOOK_VERIFY_TOKEN=choose-any-secret-string
# Webhook URL in Meta: https://YOUR-SUBDOMAIN.ngrok-free.app/api/meta/webhook

# Shopify Partner app (Phase 1D — read-only)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_OAUTH_REDIRECT_URI=http://localhost:5000/integrations/callback
# Read-only until Shopify app review approves write scopes (default):
SHOPIFY_SCOPES=read_orders,read_products,read_content
# Full autopilot (pages + product SEO writes) after approval:
# SHOPIFY_SCOPES=read_orders,read_products,read_content,write_content,write_products
# MCP bridge public URLs (https — same host as WEB_ORIGIN / ngrok)
# ANALYTICS_MCP_PUBLIC_URL=https://YOUR-HOST/mcp/analytics
# GOOGLE_ADS_MCP_PUBLIC_URL=https://YOUR-HOST/mcp/google-ads
# META_ADS_MCP_PUBLIC_URL=https://YOUR-HOST/mcp/meta-ads
# SHOPIFY_MCP_PUBLIC_URL=https://YOUR-HOST/mcp/shopify
# UNSPLASH_MCP_PUBLIC_URL=https://YOUR-HOST/mcp/unsplash
# INSTAGRAM_MCP_PUBLIC_URL=https://YOUR-HOST/mcp/instagram
# MCP_BRIDGE_SECRET=   # optional; defaults to ENCRYPTION_KEY
# Unsplash stock photos (workspace-level — no OAuth)
# UNSPLASH_ACCESS_KEY=   # https://unsplash.com/developers
# Optional: use Google's hosted analytics MCP URL instead of Hundres bridge
# ANALYTICS_MCP_OFFICIAL_URL=https://analytics-mcp.googleapis.com/mcp/v1
